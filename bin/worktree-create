#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf 'Please provide a worktree/branch name\n'
  read -erp "Branch name: " branch
else
  branch="$1"
fi

# Must be run from inside an existing worktree
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf '%s\n' "Not inside a git worktree" >&2
  exit 1
}

parent_dir="$(cd "${repo_root}/.." && pwd)"
target="${parent_dir}/${branch}"

# Refuse to overwrite
if [ -e "${target}" ]; then
  printf 'Target already exists: %s\n' "${target}" >&2
  exit 1
fi

# Create worktree + branch
git worktree add "${target}" -b "${branch}"

cat <<EOF

Worktree created:

  ${target}
  branch: ${branch}

Next steps:

  cd ${target}
  direnv allow
  bin/worktree-bootstrap

EOF

# vim: ft=sh ts=2 sts=2 sw=2 sr et
